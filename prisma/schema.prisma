
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum IdentityType {
  PERSON
  ORGANIZATION
}

enum AgentStatus {
  UNVERIFIED
  VERIFIED
  SUSPENDED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  handle        String   @unique
  passwordHash  String
  displayName   String   @default("")
  identityType  IdentityType @default(PERSON)
  plan          String   @default("FREE")
  stripeCustomerId String? @unique
  stripeSubId   String?  @unique
  messagesThisMonth Int  @default(0)
  usagePeriodStart  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  keys          Key[]
  mail          Mail[]
  webhooks      Webhook[]
  sessions      Session[]
  passwordResets PasswordReset[]
  agents        Agent[]
  address       Address?
}
model Key {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("default")
  keyHash    String   @unique
  scopes     String[] @default(["send"])
  deliveries Int      @default(0)
  lastUsed   DateTime?
  createdAt  DateTime @default(now())
  @@index([keyHash])
}
model Mail {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientAddressId String?
  recipientAddress   Address? @relation(fields: [recipientAddressId], references: [id], onDelete: Restrict)
  senderName      String
  senderEmail     String
  senderHandle    String?
  senderVerified  Boolean  @default(false)
  senderIp        String?
  subject         String
  body            String
  bodyPreview     String
  payload         Json?
  mailType        String   @default("PERSONAL")
  aiSummary       String?
  aiUrgency       String   @default("NORMAL")
  aiTags          String[]
  aiTriagedAt     DateTime?
  isRead          Boolean  @default(false)
  isStarred       Boolean  @default(false)
  isArchived      Boolean  @default(false)
  isTrashed       Boolean  @default(false)
  deliveryToken   String   @unique @default(uuid())
  receiptSig      String
  deliveredAt     DateTime @default(now())
  readAt          DateTime?
  createdAt       DateTime @default(now())
  @@index([userId])
  @@index([recipientAddressId])
  @@index([deliveryToken])
}
model Webhook {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  secret        String
  events        String[] @default(["mail.received"])
  active        Boolean  @default(true)
  deliveryCount Int      @default(0)
  failureCount  Int      @default(0)
  lastStatus    String?
  lastFiredAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([userId])
}
model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([userId])
}
model SendToken {
  id              String   @id @default(uuid())
  token           String   @unique @default(uuid())
  senderEmail     String
  recipientHandle String
  verified        Boolean  @default(false)
  verifiedAt      DateTime?
  usedAt          DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  @@index([token])
}
model DeliveryReceipt {
  id        String   @id @default(uuid())
  mailId    String
  event     String
  timestamp DateTime @default(now())
  ipAddress String?
  signature String
  @@index([mailId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model Agent {
  id          String      @id @default(uuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  displayName String      @default("")
  status      AgentStatus @default(UNVERIFIED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  address     Address?
  tokens      AgentToken[]

  @@index([ownerId])
}

model AgentToken {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  label      String   @default("default")
  tokenHash  String   @unique
  scopes     String[] @default(["send"])
  deliveries Int      @default(0)
  lastUsed   DateTime?
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@index([tokenHash])
}

model Address {
  id        String   @id @default(uuid())
  handle    String   @unique
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?  @unique
  agent        Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  receivedMail Mail[]
  createdAt    DateTime @default(now())
}

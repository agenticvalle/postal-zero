# PostgreSQL connection for Fly/Postgres or Neon
DATABASE_URL=postgresql://postgres:password@localhost:5432/postal_zero?schema=public

# Redis URL for BullMQ (Fly Redis, Upstash, or self-hosted)
REDIS_URL=redis://localhost:6379

# JWT auth secret
JWT_SECRET=replace-with-strong-jwt-secret

# Receipt signing secret for delivery receipts
RECEIPT_SIGNING_SECRET=replace-with-strong-hmac-secret

# Webhook HMAC signing secret
WEBHOOK_HMAC_SECRET=replace-with-strong-hmac-secret

# Metrics, logging, and security
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Frontend runtime
NEXT_PUBLIC_API_URL=http://localhost:3000
